{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "party-pocket-room",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "PartyRoom"
      }
    ]
  },
  "exports": {
    "PartyRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://kameusagiyahoo.github.io,http://localhost:8788,http://127.0.0.1:8788"
  }
}
